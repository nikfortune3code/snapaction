<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allow cleartext HTTP to the local dev backend server.
        10.0.2.2 = Android emulator localhost alias
        192.168.1.7 = PC LAN IP for physical device testing (same Wi-Fi)
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.7</domain>
    </domain-config>
</network-security-config>
