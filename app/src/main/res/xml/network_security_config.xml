<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allow cleartext HTTP to the local dev backend server (10.0.2.2 = emulator localhost).
        This only applies to debug builds. In production, all traffic should use HTTPS.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Also allow LAN IP for physical device testing, e.g. 192.168.x.x -->
        <domain includeSubdomains="false">192.168.0.0</domain>
    </domain-config>
</network-security-config>
